# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings -> API
#
# EXPO_PUBLIC_ vars are bundled into the app and readable by anyone who installs
# it. That is fine for the anon key, which is designed to be public — row-level
# security is what protects the data, not the secrecy of this key.
#
# Never put the service_role key here. It bypasses every RLS policy.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
