# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings -> API
#
# EXPO_PUBLIC_ vars are bundled into the app and readable by anyone who installs
# it. That is fine for the anon key, which is designed to be public — row-level
# security is what protects the data, not the secrecy of this key.
#
# Never put the service_role key here. It bypasses every RLS policy.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Domain the payroll number is turned into for Supabase Auth: KP0093 signs in as
# kp0093@<domain>. It receives no mail — the address is plumbing, and
# users.auth_user_id is what actually links a login to a staff record.
# Must match the domain used in supabase/provision_logins.sql.
EXPO_PUBLIC_AUTH_EMAIL_DOMAIN=checklist.local
