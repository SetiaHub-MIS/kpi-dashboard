{
  "expo": {
    "name": "Checklist Mingguan",
    "slug": "marks-app",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e0f3ebdd-3b09-40ac-b500-2024894abe6a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "scheme": "markapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F4F2"
        }
      ],
      "expo-sharing",
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.markapp.checklist"
    },
    "android": {
      "package": "com.markapp.checklist",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "lang": "ms",
      "shortName": "Checklist",
      "themeColor": "#F4F4F2",
      "backgroundColor": "#F4F4F2"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e0f3ebdd-3b09-40ac-b500-2024894abe6a"
      }
    },
    "owner": "dgtalzme"
  }
}
